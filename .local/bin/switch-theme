#!/usr/bin/env bash
# switch-theme — repoint colorschemes/active and reload themed apps.
# The ONLY mutation is the symlink; see REFACTOR_COLORS.md.
set -euo pipefail

SCHEMES="$HOME/dotfiles/.config/colorschemes"
ACTIVE="$SCHEMES/active"

case "${1:-current}" in
    current)
        basename "$(readlink "$ACTIVE")"
        exit 0
        ;;
    list)
        find "$SCHEMES" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' | sort
        exit 0
        ;;
esac

scheme="$1"
if [[ ! -d "$SCHEMES/$scheme" ]]; then
    echo "Unknown theme '$scheme'. Available:" >&2
    "$0" list >&2
    exit 1
fi

# ── The ONLY mutation ──
ln -sfn "$scheme" "$ACTIVE"

# Record the active scheme name for watchers: a symlink repoint is invisible
# to inotify, but a changed path forces any FileView to reload from scratch.
STATE_DIR="$HOME/.local/state/colorscheme"
mkdir -p "$STATE_DIR"
echo "$scheme" > "$STATE_DIR/active"

# ── Reloads (best-effort, never fatal) ──
hyprctl reload &>/dev/null || true

pgrep -x kitty &>/dev/null && kill -USR1 $(pgrep -x kitty) || true

[[ -f "$ACTIVE/alacritty.toml" ]] && touch "$ACTIVE/alacritty.toml" || true  # mtime bump → alacritty watcher

pkill -SIGUSR2 waybar 2>/dev/null || true                  # waybar reloads CSS in place

tmux source-file "$HOME/.config/tmux/tmux.conf" &>/dev/null || true

# ── Caelestia shell bridge (quickshell): writes scheme.json + wallpaper/path.txt
# (retires hyprpaper — the shell's Background module renders the wallpaper)
caelestia-theme-bridge "$scheme" || true

if [[ -f "$ACTIVE/gtk-theme-name" ]] && command -v gsettings &>/dev/null; then
    gsettings set org.gnome.desktop.interface gtk-theme \
        "$(cat "$ACTIVE/gtk-theme-name")" 2>/dev/null || true
fi

# ── GTK settings.ini sync + gtk-4.0/libadwaita repoint (best-effort, never fatal) ──
if [[ -f "$ACTIVE/gtk-theme-name" ]]; then
    theme_name="$(cat "$ACTIVE/gtk-theme-name")" || true

    # Keep both settings.ini in line with the active theme (tolerant of nwg-look rewrites).
    for ini in "$HOME/.config/gtk-3.0/settings.ini" "$HOME/.config/gtk-4.0/settings.ini"; do
        if [[ -f "$ini" ]]; then
            if grep -qE '^\s*gtk-theme-name\s*=' "$ini"; then
                sed -i -E "s/^\s*gtk-theme-name\s*=.*/gtk-theme-name=$theme_name/" "$ini" || true
            elif grep -q '^\[Settings\]' "$ini"; then
                sed -i "/^\[Settings\]/a gtk-theme-name=$theme_name" "$ini" || true
            else
                printf '\n[Settings]\ngtk-theme-name=%s\n' "$theme_name" >> "$ini" || true
            fi
        fi
    done

    # libadwaita reads ~/.config/gtk-4.0/{gtk.css,gtk-dark.css,assets}: repoint at the
    # active theme's gtk-4.0 dir. NEVER remove existing symlinks — leaving them means
    # the last-known-good theme stays active instead of regressing to Adwaita.
    theme_dir=""
    for base in "$HOME/.themes" "$HOME/.local/share/themes" "/usr/share/themes"; do
        if [[ -d "$base/$theme_name/gtk-4.0" ]]; then
            theme_dir="$base/$theme_name"
            break
        fi
    done
    if [[ -n "$theme_dir" ]]; then
        for f in gtk.css gtk-dark.css assets; do
            if [[ -e "$theme_dir/gtk-4.0/$f" ]]; then
                ln -sfn "$theme_dir/gtk-4.0/$f" "$HOME/.config/gtk-4.0/$f" || true
            fi
        done
    else
        echo "note: '$theme_name' ships no gtk-4.0 — keeping existing gtk-4.0 symlinks" || true
    fi
fi

notify-send "Theme" "Switched to $scheme" 2>/dev/null || true
echo "Switched to $scheme (restart nvim / opencode / GTK apps / zen-browser to fully apply; re-login clears the old GTK_THEME env)"
